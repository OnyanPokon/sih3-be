<?php

namespace {{ namespace }};

use App\Http\Controllers\Controller;
use {{ requestNamespace }}\{{ requestName }};
use Illuminate\Http\Request;
use App\Traits\ApiResponse;
use Exception;
use Symfony\Component\HttpFoundation\Response;
use {{ serviceNamespace }}\{{ serviceName }};
use {{ resourceNamespace }}\{{ resourceName }};
use Dedoc\Scramble\Attributes\QueryParameter;


class {{ controllerName }} extends Controller
{
    use ApiResponse;

    protected ${{ variableService }};

    public function __construct({{ serviceName }} ${{ variableService }})
    {
        $this->{{ variableService }} = ${{ variableService }};
    }

    #[QueryParameter('per_page', description: 'Number of items per page.', type: 'int', default: 10, example: 20)]
    #[QueryParameter('page', description: 'The page number.', type: 'int', default: 1, example: 1)]
    #[QueryParameter('search', description: 'The search query.', type: 'string', default: '', example: 'title')]
    public function index(Request $request) {
        $data = $this->{{ variableService }}->getAll($request);

        return $this->successResponseWithDataIndex(
            $data,
            {{ resourceName }}::collection($data),
            'Data {{ name_lc }} berhasil diambil',
            Response::HTTP_OK
        );
    }

    public function store({{ requestName }} $request) {
        $this->{{ variableService }}->store($request);

        return $this->successResponse(
            'Berhasil menambah data {{ name_lc }}',
            Response::HTTP_CREATED
        );
    }

    public function show($id) {
        $data = $this->{{ variableService }}->show($id);

        return $this->successResponseWithData(
            {{ resourceName }}::make($data),
            'Data {{ name_lc }} berhasil diambil',
            Response::HTTP_OK
        );
    }

    public function update({{ requestName }} $request, $id) {
        $this->{{ variableService }}->update($request, $id);

        return $this->successResponse(
            'Berhasil mengubah data {{ name_lc }}',
            Response::HTTP_OK
        );
    }

    public function destroy($id) {
        $this->{{ variableService }}->destroy($id);

        return $this->successResponse(
            'Berhasil menghapus data {{ name_lc }}',
            Response::HTTP_OK
        );
    }

    public function multiDestroy(Request $request) {
        $this->{{ variableService }}->multiDestroy($request->ids);

        return $this->successResponse(
            'Berhasil menghapus data {{ name_lc }}',
            Response::HTTP_OK
        );
    }
}